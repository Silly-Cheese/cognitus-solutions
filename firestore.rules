        && shortString(request.resource.data.reviewerNotes, 1000)
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(employmentRecordPath(resource.data.recordId))
        && getAfter(employmentRecordPath(resource.data.recordId)).data.disputeStatus == request.resource.data.status
        && getAfter(employmentRecordPath(resource.data.recordId)).data.disputeNote == request.resource.data.reviewerNotes;

      allow delete: if false;
    }

    match /externalProfileClaims/{claimId} {
      allow read: if isReviewer()
        || (signedIn() && resource.data.applicantUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'profileId', 'profileCognitusId', 'applicantUid',
          'applicantCognitusId', 'applicantDisplayName', 'claimReason', 'verificationMethod',
          'status', 'reviewedByUid', 'reviewerNotes', 'reviewedAt', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.id == claimId
        && claimId == request.resource.data.profileId + '__' + request.auth.uid
        && validCognitusId(request.resource.data.cognitusId, 'PCL')
        && exists(profilePath(request.resource.data.profileId))
        && get(profilePath(request.resource.data.profileId)).data.recordOrigin == 'employer_created'
        && get(profilePath(request.resource.data.profileId)).data.linkedUserId == null
        && request.resource.data.profileCognitusId == get(profilePath(request.resource.data.profileId)).data.cognitusId
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.applicantCognitusId == currentUser().cognitusId
        && request.resource.data.applicantDisplayName == currentUser().displayName
        && shortString(request.resource.data.claimReason, 1200)
        && request.resource.data.claimReason.size() > 0
        && request.resource.data.verificationMethod in ['discord_id_match', 'manual_review']
        && (
          request.resource.data.verificationMethod == 'manual_review'
          || currentUser().discordId in get(profilePath(request.resource.data.profileId)).data.discordIds
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewerNotes == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeAccount()
        && resource.data.applicantUid == request.auth.uid
        && resource.data.status == 'denied'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'claimReason', 'verificationMethod', 'status', 'reviewedByUid', 'reviewerNotes',
          'reviewedAt', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.profileId == resource.data.profileId
        && shortString(request.resource.data.claimReason, 1200)
        && request.resource.data.claimReason.size() > 0
        && request.resource.data.verificationMethod in ['discord_id_match', 'manual_review']
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewerNotes == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isReviewer()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewedByUid', 'reviewerNotes', 'reviewedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['approved', 'denied']
        && request.resource.data.reviewedByUid == request.auth.uid
        && shortString(request.resource.data.reviewerNotes, 1000)
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'approved'
            && existsAfter(profilePath(resource.data.profileId))
            && getAfter(profilePath(resource.data.profileId)).data.linkedUserId == resource.data.applicantUid
            && getAfter(profilePath(resource.data.profileId)).data.claimedByUid == resource.data.applicantUid
            && getAfter(profilePath(resource.data.profileId)).data.identityStatus == 'claimed'
          )
          || (
            request.resource.data.status == 'denied'
            && getAfter(profilePath(resource.data.profileId)).data.linkedUserId == get(profilePath(resource.data.profileId)).data.linkedUserId
          )
        );

      allow delete: if false;
    }

    match /claims/{claimId} {
      allow read: if isReviewer() || (signedIn() && resource.data.submittedByUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'profileId', 'submittedByUid', 'submittedByCognitusId',
          'submittedDiscordId', 'statement', 'verificationMethod', 'status', 'reviewedByUid',
          'decisionNotes', 'closedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == claimId
        && validCognitusId(request.resource.data.cognitusId, 'CLM')
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.submittedByCognitusId == currentUser().cognitusId
        && request.resource.data.submittedDiscordId == currentUser().discordId
        && request.resource.data.verificationMethod == 'immutable_discord_id_match'
        && request.resource.data.status == 'pending_review'
        && exists(profilePath(request.resource.data.profileId))
        && currentUser().discordId in get(profilePath(request.resource.data.profileId)).data.discordIds
        && shortString(request.resource.data.statement, 1500)
        && request.resource.data.reviewedByUid == null
        && request.resource.data.decisionNotes == ''
        && request.resource.data.closedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isReviewer()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewedByUid', 'decisionNotes', 'closedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['pending_review', 'approved', 'denied', 'cancelled']
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /appeals/{appealId} {
      allow read: if isReviewer() || (signedIn() && resource.data.submittedByUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'profileId', 'reportId', 'submittedByUid', 'submittedByCognitusId',
          'reason', 'statement', 'status', 'reviewedByUid', 'decision', 'decisionNotes', 'closedAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == appealId
        && validCognitusId(request.resource.data.cognitusId, 'APL')
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.submittedByCognitusId == currentUser().cognitusId
        && exists(profilePath(request.resource.data.profileId))
        && exists(reportPath(request.resource.data.reportId))
        && get(reportPath(request.resource.data.reportId)).data.subjectProfileId == request.resource.data.profileId
        && ownsProfile(request.resource.data.profileId)
        && shortString(request.resource.data.reason, 200)
        && request.resource.data.reason.size() > 0
        && shortString(request.resource.data.statement, 4000)
        && request.resource.data.statement.size() > 0
        && request.resource.data.status == 'pending_review'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.decision == null
        && request.resource.data.decisionNotes == ''
        && request.resource.data.closedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isReviewer()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewedByUid', 'decision', 'decisionNotes', 'closedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['pending_review', 'under_review', 'accepted', 'denied', 'partially_accepted', 'closed']
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin() || (signedIn() && resource.data.actorUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'actorUid', 'actorCognitusId', 'actorRole', 'action',
          'targetType', 'targetId', 'summary', 'metadata', 'createdAt'
        ])
        && request.resource.data.id == auditId
        && validCognitusId(request.resource.data.cognitusId, 'AUD')
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorCognitusId == currentUser().cognitusId
        && request.resource.data.actorRole == currentUser().role
        && shortString(request.resource.data.action, 80)
        && request.resource.data.action.size() > 0
        && shortString(request.resource.data.targetType, 80)
        && shortString(request.resource.data.summary, 500)
        && request.resource.data.metadata is map
        && request.resource.data.metadata.keys().size() <= 12
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /downloads/{downloadId} {
      allow read: if isAdmin() || (signedIn() && resource.data.downloadedByUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'downloadedByUid', 'checkId', 'reportType', 'format', 'createdAt'
        ])
        && request.resource.data.id == downloadId
        && request.resource.data.downloadedByUid == request.auth.uid
        && request.resource.data.reportType in ['quick', 'full']
        && request.resource.data.format == 'print_pdf'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /settings/bootstrap {
      allow read: if isOwner();
      allow write: if false;
    }

    match /settings/portal {
      allow read: if true;
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /passwordResetRequests/{requestId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
