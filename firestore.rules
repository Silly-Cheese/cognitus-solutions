        && validCognitusId(request.resource.data.cognitusId, 'CHK')
        && request.resource.data.checkedByUid == request.auth.uid
        && request.resource.data.checkedByCognitusId == currentUser().cognitusId
        && request.resource.data.organizationId == currentUser().organizationId
        && request.resource.data.searchType in ['Person', 'Organization']
        && request.resource.data.searchField in ['Discord Username', 'Discord ID', 'Roblox Username', 'Organization Name']
        && shortString(request.resource.data.searchQuery, 100)
        && request.resource.data.searchQuery.size() > 0
        && validCheckReason(request.resource.data.reason)
        && shortString(request.resource.data.additionalNotes, 1000)
        && request.resource.data.resultIds is list
        && request.resource.data.resultIds.size() <= 20
        && request.resource.data.resultCount is int
        && request.resource.data.resultCount >= 0
        && shortString(request.resource.data.resultSummary, 200)
        && request.resource.data.downloadedReport == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isReviewer() || (signedIn() && resource.data.checkedByUid == request.auth.uid))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['downloadedReport', 'updatedAt'])
        && request.resource.data.downloadedReport == true
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if (isReviewer() || staffPermission('reports.review') || staffPermission('appeals.review'))
        || (signedIn() && resource.data.submittedByUid == request.auth.uid)
        || ownsReportSubject(resource.data)
        || hasReportGrant(reportId)
