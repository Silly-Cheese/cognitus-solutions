        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedByUid', 'reviewerNotes', 'updatedAt'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.applicantUid == resource.data.applicantUid
        && request.resource.data.applicantCognitusId == resource.data.applicantCognitusId
