        && shortString(request.resource.data.details, 5000)
        && request.resource.data.details.size() > 0
        && request.resource.data.status == 'pending_review'
        && request.resource.data.visibility == 'private_review'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.decisionNotes == ''
        && request.resource.data.publishedAt == null
        && request.resource.data.appealStatus == 'none'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

