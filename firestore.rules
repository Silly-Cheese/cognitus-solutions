        && get(userPath(resource.data.applicantUid)).data.role == 'user'
        && (
          (
            request.resource.data.status == 'approved'
            && getAfter(userPath(resource.data.applicantUid)).data.status == 'active'
            && getAfter(userPath(resource.data.applicantUid)).data.role == 'verified_employer_member'
            && getAfter(userPath(resource.data.applicantUid)).data.organizationId == resource.data.organizationId
          )
          || (
            request.resource.data.status == 'denied'
            && getAfter(userPath(resource.data.applicantUid)).data.role == get(userPath(resource.data.applicantUid)).data.role
            && getAfter(userPath(resource.data.applicantUid)).data.organizationId == get(userPath(resource.data.applicantUid)).data.organizationId
          )
        );

      allow delete: if false;
    }

    match /employerCandidates/{candidateId} {
      allow read: if isOwner() || canManageTalent(resource.data.organizationId);

      allow create: if canManageTalent(request.resource.data.organizationId)
        && request.resource.data.keys().hasOnly([
          'id', 'organizationId', 'organizationCognitusId', 'profileId', 'profileCognitusId',
          'profileDisplayName', 'pipelineStatus', 'privateNotes', 'addedByUid', 'addedByCognitusId',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == candidateId
        && candidateId == request.resource.data.organizationId + '__' + request.resource.data.profileId
        && exists(profilePath(request.resource.data.profileId))
        && exists(organizationPath(request.resource.data.organizationId))
        && get(organizationPath(request.resource.data.organizationId)).data.verificationStatus == 'verified'
        && request.resource.data.organizationCognitusId == get(organizationPath(request.resource.data.organizationId)).data.cognitusId
        && request.resource.data.profileCognitusId == get(profilePath(request.resource.data.profileId)).data.cognitusId
        && request.resource.data.profileDisplayName == get(profilePath(request.resource.data.profileId)).data.displayName
        && validPipelineStatus(request.resource.data.pipelineStatus)
        && shortString(request.resource.data.privateNotes, 3000)
        && request.resource.data.addedByUid == request.auth.uid
        && request.resource.data.addedByCognitusId == currentUser().cognitusId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canManageTalent(resource.data.organizationId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'pipelineStatus', 'privateNotes', 'updatedAt'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.organizationCognitusId == resource.data.organizationCognitusId
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.profileCognitusId == resource.data.profileCognitusId
        && request.resource.data.profileDisplayName == resource.data.profileDisplayName
        && request.resource.data.addedByUid == resource.data.addedByUid
        && request.resource.data.addedByCognitusId == resource.data.addedByCognitusId
        && request.resource.data.createdAt == resource.data.createdAt
        && validPipelineStatus(request.resource.data.pipelineStatus)
        && shortString(request.resource.data.privateNotes, 3000)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner() || canManageTalent(resource.data.organizationId);
    }

    match /employmentRecords/{recordId} {
      allow read: if isReviewer()
        || isEmployerMember()
        || ownsProfile(resource.data.profileId);

      allow create: if canAddEmploymentRecords(request.resource.data.organizationId)
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'profileId', 'profileCognitusId', 'organizationId',
          'organizationCognitusId', 'organizationName', 'positionTitle', 'department',
          'employmentType', 'startedOn', 'endedOn', 'endReason', 'eligibleForRehire',
          'recordStatus', 'visibility', 'sourceType', 'disputeStatus', 'disputeNote',
          'createdByUid', 'createdByCognitusId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == recordId
        && validCognitusId(request.resource.data.cognitusId, 'EMR')
        && exists(profilePath(request.resource.data.profileId))
        && exists(organizationPath(request.resource.data.organizationId))
        && get(organizationPath(request.resource.data.organizationId)).data.verificationStatus == 'verified'
        && request.resource.data.profileCognitusId == get(profilePath(request.resource.data.profileId)).data.cognitusId
        && request.resource.data.organizationCognitusId == get(organizationPath(request.resource.data.organizationId)).data.cognitusId
        && request.resource.data.organizationName == get(organizationPath(request.resource.data.organizationId)).data.name
        && shortString(request.resource.data.positionTitle, 120)
        && request.resource.data.positionTitle.size() > 0
        && shortString(request.resource.data.department, 100)
        && validEmploymentType(request.resource.data.employmentType)
        && shortString(request.resource.data.startedOn, 10)
        && request.resource.data.startedOn.size() == 10
        && (request.resource.data.endedOn == null || shortString(request.resource.data.endedOn, 10))
        && shortString(request.resource.data.endReason, 300)
        && validRehire(request.resource.data.eligibleForRehire)
        && request.resource.data.recordStatus in ['active', 'ended']
        && request.resource.data.visibility == 'shared_profile'
        && request.resource.data.sourceType == 'verified_employer'
        && request.resource.data.disputeStatus == 'none'
        && request.resource.data.disputeNote == ''
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByCognitusId == currentUser().cognitusId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canAddEmploymentRecords(resource.data.organizationId)
        && (
          resource.data.createdByUid == request.auth.uid
          || role() == 'org_admin'
          || isAdmin()
        )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'positionTitle', 'department', 'employmentType', 'startedOn', 'endedOn',
          'endReason', 'eligibleForRehire', 'recordStatus', 'updatedAt'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.profileCognitusId == resource.data.profileCognitusId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.organizationCognitusId == resource.data.organizationCognitusId
        && request.resource.data.organizationName == resource.data.organizationName
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.sourceType == resource.data.sourceType
        && request.resource.data.disputeStatus == resource.data.disputeStatus
        && request.resource.data.disputeNote == resource.data.disputeNote
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByCognitusId == resource.data.createdByCognitusId
        && request.resource.data.createdAt == resource.data.createdAt
        && shortString(request.resource.data.positionTitle, 120)
        && request.resource.data.positionTitle.size() > 0
        && shortString(request.resource.data.department, 100)
        && validEmploymentType(request.resource.data.employmentType)
        && shortString(request.resource.data.startedOn, 10)
        && request.resource.data.startedOn.size() == 10
        && (request.resource.data.endedOn == null || shortString(request.resource.data.endedOn, 10))
        && shortString(request.resource.data.endReason, 300)
        && validRehire(request.resource.data.eligibleForRehire)
        && request.resource.data.recordStatus in ['active', 'ended']
        && request.resource.data.updatedAt == request.time;

      allow update: if (isReviewer() || staffPermission('appeals.review'))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'disputeStatus', 'disputeNote', 'updatedAt'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.disputeStatus in ['accepted', 'denied', 'none']
        && shortString(request.resource.data.disputeNote, 1000)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner()
        || (role() == 'org_admin' && sameOrg(resource.data.organizationId));
    }

    match /employmentRecordDisputes/{disputeId} {
      allow read: if (isReviewer() || staffPermission('appeals.review'))
        || (signedIn() && resource.data.applicantUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'recordId', 'recordCognitusId', 'profileId', 'organizationId',
          'applicantUid', 'applicantCognitusId', 'applicantDisplayName', 'statement', 'status',
          'reviewedByUid', 'reviewerNotes', 'reviewedAt', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.id == disputeId
        && disputeId == request.resource.data.recordId + '__' + request.auth.uid
        && validCognitusId(request.resource.data.cognitusId, 'EDP')
        && exists(employmentRecordPath(request.resource.data.recordId))
        && request.resource.data.recordCognitusId == get(employmentRecordPath(request.resource.data.recordId)).data.cognitusId
        && request.resource.data.profileId == get(employmentRecordPath(request.resource.data.recordId)).data.profileId
        && request.resource.data.organizationId == get(employmentRecordPath(request.resource.data.recordId)).data.organizationId
        && ownsProfile(request.resource.data.profileId)
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.applicantCognitusId == currentUser().cognitusId
        && request.resource.data.applicantDisplayName == currentUser().displayName
        && shortString(request.resource.data.statement, 2000)
        && request.resource.data.statement.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewerNotes == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeAccount()
        && resource.data.applicantUid == request.auth.uid
        && resource.data.status == 'denied'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'statement', 'status', 'reviewedByUid', 'reviewerNotes', 'reviewedAt', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.recordId == resource.data.recordId
        && request.resource.data.profileId == resource.data.profileId
        && ownsProfile(resource.data.profileId)
        && shortString(request.resource.data.statement, 2000)
        && request.resource.data.statement.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewerNotes == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isReviewer() || staffPermission('appeals.review'))
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewedByUid', 'reviewerNotes', 'reviewedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['accepted', 'denied']
        && request.resource.data.reviewedByUid == request.auth.uid
        && shortString(request.resource.data.reviewerNotes, 1000)
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(employmentRecordPath(resource.data.recordId))
        && getAfter(employmentRecordPath(resource.data.recordId)).data.disputeStatus == request.resource.data.status
        && getAfter(employmentRecordPath(resource.data.recordId)).data.disputeNote == request.resource.data.reviewerNotes;

      allow delete: if false;
    }

    match /externalProfileClaims/{claimId} {
      allow read: if (isReviewer() || staffPermission('claims.review') || staffPermission('verification.review'))
        || (signedIn() && resource.data.applicantUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'profileId', 'profileCognitusId', 'applicantUid',
          'applicantCognitusId', 'applicantDisplayName', 'claimReason', 'verificationMethod',
          'status', 'reviewedByUid', 'reviewerNotes', 'reviewedAt', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.id == claimId
        && claimId == request.resource.data.profileId + '__' + request.auth.uid
        && validCognitusId(request.resource.data.cognitusId, 'PCL')
        && exists(profilePath(request.resource.data.profileId))
        && get(profilePath(request.resource.data.profileId)).data.recordOrigin == 'employer_created'
        && get(profilePath(request.resource.data.profileId)).data.linkedUserId == null
        && request.resource.data.profileCognitusId == get(profilePath(request.resource.data.profileId)).data.cognitusId
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.applicantCognitusId == currentUser().cognitusId
        && request.resource.data.applicantDisplayName == currentUser().displayName
        && shortString(request.resource.data.claimReason, 1200)
        && request.resource.data.claimReason.size() > 0
        && request.resource.data.verificationMethod in ['discord_id_match', 'manual_review']
        && (
          request.resource.data.verificationMethod == 'manual_review'
          || currentUser().discordId in get(profilePath(request.resource.data.profileId)).data.discordIds
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewerNotes == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeAccount()
        && resource.data.applicantUid == request.auth.uid
        && resource.data.status == 'denied'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'claimReason', 'verificationMethod', 'status', 'reviewedByUid', 'reviewerNotes',
          'reviewedAt', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.profileId == resource.data.profileId
        && shortString(request.resource.data.claimReason, 1200)
        && request.resource.data.claimReason.size() > 0
        && request.resource.data.verificationMethod in ['discord_id_match', 'manual_review']
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewerNotes == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isReviewer() || staffPermission('claims.review') || staffPermission('verification.review'))
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewedByUid', 'reviewerNotes', 'reviewedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['approved', 'denied']
        && request.resource.data.reviewedByUid == request.auth.uid
        && shortString(request.resource.data.reviewerNotes, 1000)
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'approved'
            && existsAfter(profilePath(resource.data.profileId))
            && getAfter(profilePath(resource.data.profileId)).data.linkedUserId == resource.data.applicantUid
            && getAfter(profilePath(resource.data.profileId)).data.claimedByUid == resource.data.applicantUid
            && getAfter(profilePath(resource.data.profileId)).data.identityStatus == 'claimed'
          )
          || (
            request.resource.data.status == 'denied'
            && getAfter(profilePath(resource.data.profileId)).data.linkedUserId == get(profilePath(resource.data.profileId)).data.linkedUserId
          )
        );

      allow delete: if false;
    }

    match /claims/{claimId} {
      allow read: if (isReviewer() || staffPermission('claims.review'))
        || (signedIn() && resource.data.submittedByUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'profileId', 'submittedByUid', 'submittedByCognitusId',
          'submittedDiscordId', 'statement', 'verificationMethod', 'status', 'reviewedByUid',
          'decisionNotes', 'closedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == claimId
        && validCognitusId(request.resource.data.cognitusId, 'CLM')
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.submittedByCognitusId == currentUser().cognitusId
        && request.resource.data.submittedDiscordId == currentUser().discordId
        && request.resource.data.verificationMethod == 'immutable_discord_id_match'
        && request.resource.data.status == 'pending_review'
        && exists(profilePath(request.resource.data.profileId))
        && currentUser().discordId in get(profilePath(request.resource.data.profileId)).data.discordIds
        && shortString(request.resource.data.statement, 1500)
        && request.resource.data.reviewedByUid == null
        && request.resource.data.decisionNotes == ''
        && request.resource.data.closedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isReviewer() || staffPermission('claims.review'))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewedByUid', 'decisionNotes', 'closedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['pending_review', 'approved', 'denied', 'cancelled']
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /appeals/{appealId} {
      allow read: if (isReviewer() || staffPermission('appeals.review'))
        || (signedIn() && resource.data.submittedByUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'profileId', 'reportId', 'submittedByUid', 'submittedByCognitusId',
          'reason', 'statement', 'status', 'reviewedByUid', 'decision', 'decisionNotes',
          'closedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == appealId
        && validCognitusId(request.resource.data.cognitusId, 'APL')
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.submittedByCognitusId == currentUser().cognitusId
        && exists(profilePath(request.resource.data.profileId))
        && exists(reportPath(request.resource.data.reportId))
        && get(reportPath(request.resource.data.reportId)).data.subjectProfileId == request.resource.data.profileId
        && ownsProfile(request.resource.data.profileId)
        && shortString(request.resource.data.reason, 200)
        && request.resource.data.reason.size() > 0
        && shortString(request.resource.data.statement, 4000)
        && request.resource.data.statement.size() > 0
        && request.resource.data.status == 'pending_review'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.decision == null
        && request.resource.data.decisionNotes == ''
        && request.resource.data.closedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isReviewer() || staffPermission('appeals.review'))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewedByUid', 'decision', 'decisionNotes', 'closedAt', 'updatedAt'
        ])
        && request.resource.data.status in [
          'pending_review', 'under_review', 'accepted', 'denied', 'partially_accepted', 'closed'
        ]
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin() || staffPermission('audit.read')
        || (signedIn() && resource.data.actorUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'actorUid', 'actorCognitusId', 'actorRole', 'action',
          'targetType', 'targetId', 'summary', 'metadata', 'createdAt'
        ])
        && request.resource.data.id == auditId
        && validCognitusId(request.resource.data.cognitusId, 'AUD')
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorCognitusId == currentUser().cognitusId
        && request.resource.data.actorRole == currentUser().role
        && shortString(request.resource.data.action, 80)
        && request.resource.data.action.size() > 0
        && shortString(request.resource.data.targetType, 80)
        && shortString(request.resource.data.summary, 500)
        && request.resource.data.metadata is map
        && request.resource.data.metadata.keys().size() <= 12
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /downloads/{downloadId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.downloadedByUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'downloadedByUid', 'checkId', 'reportType', 'format', 'createdAt'
        ])
        && request.resource.data.id == downloadId
        && request.resource.data.downloadedByUid == request.auth.uid
        && request.resource.data.reportType in ['quick', 'full']
        && request.resource.data.format == 'print_pdf'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /settings/bootstrap {
      allow read: if isOwner();
      allow write: if false;
    }

    // Public client configuration and live-event state.
    // Reads remain public for the current Frenzy bootstrap. Writes
    // are Owner-only and must satisfy the V36 schema validators.
    match /settings/portal {
      allow read: if true;

      allow create: if isOwner()
        && validPortalSettings(request.resource.data);

      allow update: if isOwner()
        && validPortalSettings(request.resource.data);

      allow delete: if false;
    }

    match /passwordResetRequests/{requestId} {
      allow read, write: if false;
    }


    // Foundation V19: canonical identities, organization membership, privacy, and repair tooling.
    match /organizationMembers/{memberId} {
      allow read: if isAdmin()
        || (activeAccount() && sameOrg(resource.data.organizationId));

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'organizationId', 'organizationCognitusId', 'userUid', 'userCognitusId',
          'displayName', 'positionTitle', 'memberStatus', 'permissions', 'grantedByUid',
          'removalRequestedByUid', 'removalRequestedAt', 'removedByUid', 'removedAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == memberId
        && memberId == request.resource.data.organizationId + '__' + request.resource.data.userUid
        && exists(organizationPath(request.resource.data.organizationId))
        && exists(userPath(request.resource.data.userUid))
        && get(userPath(request.resource.data.userUid)).data.organizationId == request.resource.data.organizationId
        && request.resource.data.organizationCognitusId == get(organizationPath(request.resource.data.organizationId)).data.cognitusId
        && request.resource.data.userCognitusId == get(userPath(request.resource.data.userUid)).data.cognitusId
        && request.resource.data.permissions is map
        && request.resource.data.permissions.keys().hasOnly([
          'runChecks', 'manageTalent', 'addEmploymentRecords', 'requestReports', 'manageMembers'
        ])
        && request.resource.data.permissions.runChecks is bool
        && request.resource.data.permissions.manageTalent is bool
        && request.resource.data.permissions.addEmploymentRecords is bool
        && request.resource.data.permissions.requestReports is bool
        && request.resource.data.permissions.manageMembers is bool
        && request.resource.data.memberStatus in ['active', 'pending', 'suspended', 'removal_requested', 'removed']
        && (
          (
            request.resource.data.userUid == request.auth.uid
            && sameOrg(request.resource.data.organizationId)
            && isEmployerMember()
            && request.resource.data.memberStatus == 'active'
            && request.resource.data.permissions.runChecks == true
            && request.resource.data.permissions.manageTalent == true
            && request.resource.data.permissions.addEmploymentRecords == true
            && request.resource.data.permissions.requestReports == true
            && request.resource.data.permissions.manageMembers == false
            && request.resource.data.grantedByUid == request.auth.uid
          )
          || canManageMembers(request.resource.data.organizationId)
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.permissions is map
        && request.resource.data.permissions.keys().hasOnly([
          'runChecks', 'manageTalent', 'addEmploymentRecords', 'requestReports', 'manageMembers'
        ])
        && request.resource.data.memberStatus in ['active', 'pending', 'suspended', 'removal_requested', 'removed']
        && request.resource.data.updatedAt == request.time;

      allow update: if canManageMembers(resource.data.organizationId)
        && sameOrg(resource.data.organizationId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'displayName', 'positionTitle', 'memberStatus', 'permissions',
          'removalRequestedByUid', 'removalRequestedAt', 'updatedAt'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.permissions is map
        && request.resource.data.permissions.manageMembers == resource.data.permissions.manageMembers
        && request.resource.data.memberStatus in ['active', 'suspended', 'removal_requested']
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner();
    }

    match /privacyRequests/{privacyId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.requesterUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'requesterUid', 'requesterCognitusId', 'requestType', 'statement',
          'status', 'reviewedByUid', 'reviewerNotes', 'decidedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == privacyId
        && validCognitusId(request.resource.data.cognitusId, 'PVR')
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterCognitusId == currentUser().cognitusId
        && request.resource.data.requestType in ['correction', 'deletion', 'data_review']
        && shortString(request.resource.data.statement, 3000)
        && request.resource.data.statement.size() >= 10
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewerNotes == ''
        && request.resource.data.decidedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewedByUid', 'reviewerNotes', 'decidedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['pending', 'accepted', 'denied', 'completed']
        && request.resource.data.reviewedByUid == request.auth.uid
        && shortString(request.resource.data.reviewerNotes, 1500)
        && request.resource.data.decidedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner() && resource.data.status == 'completed';
    }

    match /profileMergeMap/{sourceProfileId} {
      allow read: if activeAccount();

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          'sourceProfileId', 'targetProfileId', 'sourceCognitusId', 'targetCognitusId',
          'reason', 'mergedByUid', 'mergedAt'
        ])
        && request.resource.data.sourceProfileId == sourceProfileId
        && request.resource.data.sourceProfileId != request.resource.data.targetProfileId
        && exists(profilePath(request.resource.data.sourceProfileId))
        && exists(profilePath(request.resource.data.targetProfileId))
        && request.resource.data.sourceCognitusId == get(profilePath(request.resource.data.sourceProfileId)).data.cognitusId
        && request.resource.data.targetCognitusId == get(profilePath(request.resource.data.targetProfileId)).data.cognitusId
        && request.resource.data.mergedByUid == request.auth.uid
        && shortString(request.resource.data.reason, 1000)
        && request.resource.data.mergedAt == request.time;

      allow update, delete: if false;
    }

    // Owner-only canonical profile creation and repair workflows.
    match /profiles/{profileId} {
      allow create: if isOwner()
        && exists(userPath(profileId))
        && request.resource.data.id == profileId
        && request.resource.data.linkedUserId == profileId
        && request.resource.data.claimedByUid == profileId
        && request.resource.data.discordIds == [get(userPath(profileId)).data.discordId]
        && request.resource.data.type == 'person'
        && validCognitusId(request.resource.data.cognitusId, 'PRF')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'displayName', 'discordUsernames', 'discordUsernamesNormalized', 'discordIds',
          'robloxUsernames', 'robloxUsernamesNormalized', 'knownAliases', 'canonicalProfileId',
          'mergedIntoProfileId', 'mergedAt', 'mergedByUid', 'identityStatus', 'updatedAt'
        ])
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.id == resource.data.id
        && request.resource.data.updatedAt == request.time;
    }

    // Owner-only reference rewrites used after a canonical profile merge.
    match /reports/{reportId} {
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['subjectProfileId', 'updatedAt'])
        && request.resource.data.subjectOrganizationId == resource.data.subjectOrganizationId
        && request.resource.data.subjectProfileId != null
        && exists(profilePath(request.resource.data.subjectProfileId))
        && request.resource.data.updatedAt == request.time;
    }

    match /screeningReportSummaries/{summaryId} {
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['subjectProfileId', 'updatedAt'])
        && request.resource.data.subjectProfileId != null
        && exists(profilePath(request.resource.data.subjectProfileId))
        && request.resource.data.updatedAt == request.time;
    }

    match /employmentRecords/{recordId} {
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['profileId', 'profileCognitusId', 'updatedAt'])
        && exists(profilePath(request.resource.data.profileId))
        && request.resource.data.profileCognitusId == get(profilePath(request.resource.data.profileId)).data.cognitusId
        && request.resource.data.updatedAt == request.time;
    }

    match /employmentRecordDisputes/{disputeId} {
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['profileId', 'updatedAt'])
        && exists(profilePath(request.resource.data.profileId))
        && request.resource.data.updatedAt == request.time;
    }

    match /reportAccessRequests/{requestId} {
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['subjectProfileId', 'updatedAt'])
        && exists(profilePath(request.resource.data.subjectProfileId))
        && request.resource.data.updatedAt == request.time;
    }

    match /reportAccessGrants/{reportId} {
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['subjectProfileId', 'updatedAt'])
        && exists(profilePath(request.resource.data.subjectProfileId))
        && request.resource.data.updatedAt == request.time;
    }

    match /claims/{claimId} {
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['profileId', 'updatedAt'])
        && exists(profilePath(request.resource.data.profileId))
        && request.resource.data.updatedAt == request.time;
    }

    match /appeals/{appealId} {
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['profileId', 'updatedAt'])
        && exists(profilePath(request.resource.data.profileId))
        && request.resource.data.updatedAt == request.time;
    }

    match /checkLogs/{checkId} {
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['targetProfileId', 'updatedAt'])
        && request.resource.data.targetProfileId != null
        && exists(profilePath(request.resource.data.targetProfileId))
        && request.resource.data.updatedAt == request.time;
    }

    match /employerCandidates/{candidateId} {
      allow create: if isOwner()
        && request.resource.data.id == candidateId
        && candidateId == request.resource.data.organizationId + '__' + request.resource.data.profileId
        && exists(profilePath(request.resource.data.profileId))
        && exists(organizationPath(request.resource.data.organizationId))
        && request.resource.data.profileCognitusId == get(profilePath(request.resource.data.profileId)).data.cognitusId
        && request.resource.data.profileDisplayName == get(profilePath(request.resource.data.profileId)).data.displayName
        && validPipelineStatus(request.resource.data.pipelineStatus)
        && shortString(request.resource.data.privateNotes, 3000)
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['pipelineStatus', 'privateNotes', 'updatedAt'])
        && validPipelineStatus(request.resource.data.pipelineStatus)
        && shortString(request.resource.data.privateNotes, 3000)
        && request.resource.data.updatedAt == request.time;
    }


    // ============================================================
    // PROMOTIONAL / FEATURE ACCESS — V36
    //
    // These rules authorize entitlement records only. They DO NOT
    // authorize access to protected reports, employment records,
    // staff queues, organization administration, or Owner functions.
    // Each underlying collection above remains authoritative.
    //
    // Signal Zero is deliberately only an entitlement here. Its
    // Frenzy-time availability is controlled by settings/portal in
    // the application, while all data reads still pass the ordinary
    // report/employment/profile rules.
    // ============================================================
    match /promotionalCodes/{code} {
      allow get: if activeAccount();
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id', 'code', 'campaignName', 'description', 'status', 'startsAt', 'redeemUntil',
          'maxTotalRedemptions', 'maxPerAccount', 'redeemedCount', 'accessMode',
          'accessDurationSeconds', 'accessEndsAt', 'campaignExpiryBehavior', 'featureIds',
          'eligibleRoles', 'eligibleOrganizationId', 'distribution', 'createdByUid',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == code
        && request.resource.data.code == code
        && code.matches('^[A-Z0-9_-]{4,40}$')
        && shortString(request.resource.data.campaignName, 100)
        && request.resource.data.campaignName.size() > 0
        && shortString(request.resource.data.description, 1000)
        && request.resource.data.status in ['active', 'paused', 'revoked']
        && (request.resource.data.startsAt == null || request.resource.data.startsAt is timestamp)
        && (request.resource.data.redeemUntil == null || request.resource.data.redeemUntil is timestamp)
        && request.resource.data.maxTotalRedemptions is int
        && request.resource.data.maxTotalRedemptions >= 0
        && request.resource.data.maxTotalRedemptions <= 100000
        && request.resource.data.maxPerAccount is int
        && request.resource.data.maxPerAccount >= 1
        && request.resource.data.maxPerAccount <= 100
        && request.resource.data.redeemedCount == 0
        && request.resource.data.accessMode in ['permanent', 'duration', 'fixed_end']
        && request.resource.data.accessDurationSeconds is int
        && request.resource.data.accessDurationSeconds >= 3600
        && request.resource.data.accessDurationSeconds <= 157680000
        && (request.resource.data.accessEndsAt == null || request.resource.data.accessEndsAt is timestamp)
        && request.resource.data.campaignExpiryBehavior in ['preserve_access', 'revoke_on_campaign_end']
        && validPromoFeatureList(request.resource.data.featureIds)
        && validPromoEligibleRoles(request.resource.data.eligibleRoles)
        && (request.resource.data.eligibleOrganizationId == null || shortString(request.resource.data.eligibleOrganizationId, 128))
        && request.resource.data.distribution in ['secret', 'campaign']
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.code == resource.data.code
        && request.resource.data.redeemedCount == resource.data.redeemedCount
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['active', 'paused', 'revoked']
        && shortString(request.resource.data.campaignName, 100)
        && shortString(request.resource.data.description, 1000)
        && request.resource.data.maxTotalRedemptions is int
        && request.resource.data.maxTotalRedemptions >= 0
        && request.resource.data.maxTotalRedemptions <= 100000
        && request.resource.data.maxPerAccount is int
        && request.resource.data.maxPerAccount >= 1
        && request.resource.data.maxPerAccount <= 100
        && request.resource.data.accessMode in ['permanent', 'duration', 'fixed_end']
        && request.resource.data.accessDurationSeconds is int
        && request.resource.data.accessDurationSeconds >= 3600
        && request.resource.data.accessDurationSeconds <= 157680000
        && (request.resource.data.startsAt == null || request.resource.data.startsAt is timestamp)
        && (request.resource.data.redeemUntil == null || request.resource.data.redeemUntil is timestamp)
        && (request.resource.data.accessEndsAt == null || request.resource.data.accessEndsAt is timestamp)
        && request.resource.data.campaignExpiryBehavior in ['preserve_access', 'revoke_on_campaign_end']
        && validPromoFeatureList(request.resource.data.featureIds)
        && validPromoEligibleRoles(request.resource.data.eligibleRoles)
        && (request.resource.data.eligibleOrganizationId == null || shortString(request.resource.data.eligibleOrganizationId, 128))
        && request.resource.data.distribution in ['secret', 'campaign']
        && request.resource.data.updatedAt == request.time;

      allow update: if promoEligible(code)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['redeemedCount', 'updatedAt'])
        && request.resource.data.redeemedCount == resource.data.redeemedCount + 1
        && (resource.data.maxTotalRedemptions == 0 || request.resource.data.redeemedCount <= resource.data.maxTotalRedemptions)
        && request.resource.data.updatedAt == request.time
        && existsAfter(promoRedemptionPath(code, request.auth.uid))
        && getAfter(promoRedemptionPath(code, request.auth.uid)).data.promoId == code
        && getAfter(promoRedemptionPath(code, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(promoRedemptionPath(code, request.auth.uid)).data.lastRedeemedAt == request.time;

      allow delete: if isOwner() && resource.data.redeemedCount == 0;
    }

    match /promoRedemptions/{redemptionId} {
      allow read: if isAdmin() || (activeAccount() && resource.data.uid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'promoId', 'code', 'uid', 'userCognitusId', 'redemptionCount', 'featureIds',
          'status', 'source', 'grantedAt', 'expiresAt', 'campaignEndsAt',
          'campaignExpiryBehavior', 'lastRedeemedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == redemptionId
        && redemptionId == request.resource.data.promoId + '__' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code == request.resource.data.promoId
        && promoEligible(request.resource.data.promoId)
        && request.resource.data.userCognitusId == currentUser().cognitusId
        && request.resource.data.redemptionCount == 1
        && request.resource.data.redemptionCount <= get(promotionalCodePath(request.resource.data.promoId)).data.maxPerAccount
        && request.resource.data.featureIds == get(promotionalCodePath(request.resource.data.promoId)).data.featureIds
        && validPromoFeatureList(request.resource.data.featureIds)
        && request.resource.data.status == 'active'
        && request.resource.data.source == 'promotional_code'
        && validPromoExpiry(request.resource.data.promoId, request.resource.data.expiresAt)
        && request.resource.data.campaignEndsAt == get(promotionalCodePath(request.resource.data.promoId)).data.redeemUntil
        && request.resource.data.campaignExpiryBehavior == get(promotionalCodePath(request.resource.data.promoId)).data.campaignExpiryBehavior
        && request.resource.data.grantedAt == request.time
        && request.resource.data.lastRedeemedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(promotionalCodePath(request.resource.data.promoId)).data.redeemedCount == get(promotionalCodePath(request.resource.data.promoId)).data.redeemedCount + 1;

      allow update: if activeAccount()
        && resource.data.uid == request.auth.uid
        && promoEligible(resource.data.promoId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.promoId == resource.data.promoId
        && request.resource.data.code == resource.data.code
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.userCognitusId == resource.data.userCognitusId
        && request.resource.data.source == resource.data.source
        && request.resource.data.grantedAt == resource.data.grantedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.redemptionCount == resource.data.redemptionCount + 1
        && request.resource.data.redemptionCount <= get(promotionalCodePath(resource.data.promoId)).data.maxPerAccount
        && request.resource.data.featureIds == get(promotionalCodePath(resource.data.promoId)).data.featureIds
        && validPromoFeatureList(request.resource.data.featureIds)
        && request.resource.data.status == 'active'
        && validPromoExpiry(resource.data.promoId, request.resource.data.expiresAt)
        && request.resource.data.campaignEndsAt == get(promotionalCodePath(resource.data.promoId)).data.redeemUntil
        && request.resource.data.campaignExpiryBehavior == get(promotionalCodePath(resource.data.promoId)).data.campaignExpiryBehavior
        && request.resource.data.lastRedeemedAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(promotionalCodePath(resource.data.promoId)).data.redeemedCount == get(promotionalCodePath(resource.data.promoId)).data.redeemedCount + 1;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['active', 'revoked']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /promoAccessGrants/{grantId} {
      allow read: if isAdmin() || (activeAccount() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id', 'uid', 'userCognitusId', 'featureIds', 'status', 'source', 'label', 'note',
          'expiresAt', 'grantedByUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == grantId
        && exists(userPath(request.resource.data.uid))
        && get(userPath(request.resource.data.uid)).data.status == 'active'
        && request.resource.data.userCognitusId == get(userPath(request.resource.data.uid)).data.cognitusId
        && validPromoFeatureList(request.resource.data.featureIds)
        && request.resource.data.status == 'active'
        && request.resource.data.source == 'manual_grant'
        && shortString(request.resource.data.label, 80)
        && shortString(request.resource.data.note, 500)
        && (request.resource.data.expiresAt == null || request.resource.data.expiresAt is timestamp)
        && request.resource.data.grantedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.userCognitusId == resource.data.userCognitusId
        && request.resource.data.source == resource.data.source
        && request.resource.data.grantedByUid == resource.data.grantedByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validPromoFeatureList(request.resource.data.featureIds)
        && request.resource.data.status in ['active', 'revoked']
        && shortString(request.resource.data.label, 80)
        && shortString(request.resource.data.note, 500)
        && (request.resource.data.expiresAt == null || request.resource.data.expiresAt is timestamp)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner();
    }

    match /promoUserData/{recordId} {
      allow read: if isAdmin() || (activeAccount() && resource.data.ownerUid == request.auth.uid);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'ownerUid', 'type', 'title', 'subjectId', 'organizationId', 'payload',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == recordId
        && request.resource.data.ownerUid == request.auth.uid
        && validPromoWorkspaceType(request.resource.data.type)
        && shortString(request.resource.data.title, 120)
        && (request.resource.data.subjectId == null || shortString(request.resource.data.subjectId, 128))
        && (request.resource.data.organizationId == null || shortString(request.resource.data.organizationId, 128))
        && request.resource.data.payload is map
        && request.resource.data.payload.keys().size() <= 30
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeAccount()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && shortString(request.resource.data.title, 120)
        && (request.resource.data.subjectId == null || shortString(request.resource.data.subjectId, 128))
        && (request.resource.data.organizationId == null || shortString(request.resource.data.organizationId, 128))
        && request.resource.data.payload is map
        && request.resource.data.payload.keys().size() <= 30
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin() || (activeAccount() && resource.data.ownerUid == request.auth.uid);
    }


    // ============================================================
    // MAIN COGNITUS — PART 1 COMPLETION
    //
    // Canonical V1 collections that were declared by the main product but did
    // not previously have an explicit security boundary. These rules belong in
    // this authoritative main-project ruleset because Main Cognitus and
    // Staff / Command share the same Firestore database.
    // ============================================================

    // ------------------------------------------------------------
    // USER NOTIFICATIONS
    // Recipient-scoped reads. Main Cognitus reviewers may create workflow
    // notifications for another user; ordinary accounts may only create their
    // own notification records. Recipients may only mark a record read.
    // ------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if activeAccount()
        && (
          resource.data.userId == request.auth.uid
          || isReviewer()
        );

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'userId', 'title', 'message', 'type', 'link',
          'read', 'readAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == notificationId
        && request.resource.data.cognitusId is string
        && request.resource.data.cognitusId.matches('^NTF-[0-9]{2}-[A-Z2-9]{6,7}$')
        && request.resource.data.userId is string
        && exists(userPath(request.resource.data.userId))
        && (
          request.resource.data.userId == request.auth.uid
          || isReviewer()
        )
        && shortString(request.resource.data.title, 160)
        && request.resource.data.title.size() > 0
        && shortString(request.resource.data.message, 2000)
        && shortString(request.resource.data.type, 50)
        && shortString(request.resource.data.link, 500)
        && request.resource.data.read == false
        && request.resource.data.readAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeAccount()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'read', 'readAt', 'updatedAt'
        ])
        && request.resource.data.read == true
        && request.resource.data.readAt != null
        && (
          request.resource.data.readAt is timestamp
          || shortString(request.resource.data.readAt, 80)
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ------------------------------------------------------------
    // SAVED CANDIDATES
    // Entirely user-owned. Organization context is captured at save time but
    // never grants another member access to a user's personal saved list.
    // ------------------------------------------------------------
    match /savedCandidates/{savedId} {
      allow read: if activeAccount()
        && resource.data.userId == request.auth.uid;

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'organizationId', 'profileId', 'label', 'status',
          'notesCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == savedId
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.organizationId == null
          || request.resource.data.organizationId == currentUser().organizationId
        )
        && request.resource.data.profileId is string
        && exists(profilePath(request.resource.data.profileId))
        && shortString(request.resource.data.label, 120)
        && request.resource.data.label.size() > 0
        && shortString(request.resource.data.status, 60)
        && request.resource.data.notesCount is int
        && request.resource.data.notesCount >= 0
        && request.resource.data.notesCount <= 100000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeAccount()
        && resource.data.userId == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'label', 'status', 'notesCount', 'updatedAt'
        ])
        && shortString(request.resource.data.label, 120)
        && request.resource.data.label.size() > 0
        && shortString(request.resource.data.status, 60)
        && request.resource.data.notesCount is int
        && request.resource.data.notesCount >= 0
        && request.resource.data.notesCount <= 100000
        && request.resource.data.updatedAt == request.time;

      allow delete: if activeAccount()
        && resource.data.userId == request.auth.uid;
    }

    // ------------------------------------------------------------
    // SAVED ORGANIZATIONS
    // ------------------------------------------------------------
    match /savedOrganizations/{savedId} {
      allow read: if activeAccount()
        && resource.data.userId == request.auth.uid;

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'organizationId', 'savedOrganizationId', 'label',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == savedId
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.organizationId == null
          || request.resource.data.organizationId == currentUser().organizationId
        )
        && request.resource.data.savedOrganizationId is string
        && exists(organizationPath(request.resource.data.savedOrganizationId))
        && shortString(request.resource.data.label, 120)
        && request.resource.data.label.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeAccount()
        && resource.data.userId == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.savedOrganizationId == resource.data.savedOrganizationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'label', 'updatedAt'
        ])
        && shortString(request.resource.data.label, 120)
        && request.resource.data.label.size() > 0
        && request.resource.data.updatedAt == request.time;

      allow delete: if activeAccount()
        && resource.data.userId == request.auth.uid;
    }

    // ------------------------------------------------------------
    // ORGANIZATION-PRIVATE NOTES
    // Private notes are never globally readable. The query must be scoped to
    // the caller's organization and the caller must have talent-management
    // authority for that organization.
    // ------------------------------------------------------------
    match /privateNotes/{noteId} {
      allow read: if activeAccount()
        && resource.data.organizationId != null
        && canManageTalent(resource.data.organizationId);

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'id', 'organizationId', 'createdByUid', 'profileId',
          'organizationTargetId', 'note', 'visibility', 'archived',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == noteId
        && request.resource.data.organizationId != null
        && request.resource.data.organizationId == currentUser().organizationId
        && canManageTalent(request.resource.data.organizationId)
        && request.resource.data.createdByUid == request.auth.uid
        && (
          (request.resource.data.profileId is string
            && request.resource.data.organizationTargetId == null
            && exists(profilePath(request.resource.data.profileId)))
          ||
          (request.resource.data.profileId == null
            && request.resource.data.organizationTargetId is string
            && exists(organizationPath(request.resource.data.organizationTargetId)))
        )
        && shortString(request.resource.data.note, 5000)
        && request.resource.data.note.size() > 0
        && request.resource.data.visibility == 'organization_private'
        && request.resource.data.archived == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeAccount()
        && canManageTalent(resource.data.organizationId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.organizationTargetId == resource.data.organizationTargetId
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'archived', 'updatedAt'
        ])
        && request.resource.data.archived is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ------------------------------------------------------------
    // RESERVED MAIN-PRODUCT COLLECTIONS
    // These names are part of the canonical V1 model, but the current main
    // client has no production write workflow/schema for them. Explicit deny
    // makes their status intentional and prevents future accidental exposure.
    // They must be opened only alongside the feature that defines their schema.
    // ------------------------------------------------------------
    match /candidatePipelines/{pipelineId} {
      allow read, write: if false;
    }

    match /duplicateReviews/{reviewId} {
      allow read, write: if false;
    }

    match /employmentHistory/{historyId} {
      allow read, write: if false;
    }

    match /certifications/{certificationId} {
      allow read, write: if false;
    }

    // ============================================================
    // COGNITUS STAFF / COMMAND — GENERATION 1
    //
    // Staff identity is intentionally separate from product roles. The
    // public portal and Command share one Firebase Auth UID and database,
    // while staffAccess/{uid} is the internal authorization boundary.
    // ============================================================

    function staffAccessPath(uid) {
      return /databases/$(database)/documents/staffAccess/$(uid);
    }

    function staffDirectoryPath(uid) {
      return /databases/$(database)/documents/staffDirectory/$(uid);
    }

    function staffEmploymentPath(uid) {
      return /databases/$(database)/documents/staffEmployment/$(uid);
    }

    function hasStaffAccess() {
      return signedIn() && exists(staffAccessPath(request.auth.uid));
    }

    function currentStaff() {
      return get(staffAccessPath(request.auth.uid)).data;
    }

    function activeStaff() {
      return hasStaffAccess()
        && currentStaff().status in ['active', 'training', 'on_leave']
        && currentStaff().permissions is list
        && 'portal.access' in currentStaff().permissions;
    }

    function staffPermission(permission) {
      return activeStaff() && permission in currentStaff().permissions;
    }

    function validStaffStatus(value) {
      return value in ['active', 'training', 'on_leave', 'suspended', 'former'];
    }

    function validStaffRank(value) {
      return value in [
        'owner', 'chief-officer', 'director', 'manager', 'supervisor',
        'senior-staff', 'staff', 'trainee', 'restricted'
      ];
    }

    function validStaffDepartment(value) {
      return value in [
        'executive-office', 'public-relations', 'customer-service',
        'finance', 'human-resources', 'quality-assurance'
      ];
    }

    function staffRankLevel(rank) {
      return rank == 'owner' ? 100
        : rank == 'chief-officer' ? 90
        : rank == 'director' ? 75
        : rank == 'manager' ? 60
        : rank == 'supervisor' ? 50
        : rank == 'senior-staff' ? 40
        : rank == 'staff' ? 30
        : rank == 'trainee' ? 20
        : 0;
    }

    function validStaffEmployeeId(value) {
      return value is string && value.matches('^COG-[0-9]{6}$');
    }

    function validStaffPermissions(value) {
      return value is list
        && value.size() >= 1
        && value.size() <= 41
        && value.hasOnly([
          'portal.access', 'directory.read', 'profile.read', 'department.read',
          'department.manage', 'staff.provision', 'staff.manage', 'staff.private.read',
          'permissions.manage', 'tickets.read', 'tickets.manage', 'tickets.all.read',
          'cs.manage', 'pr.manage', 'pr.approve', 'finance.read', 'finance.manage',
          'payroll.read', 'payroll.manage', 'payroll.approve', 'hr.records.read',
          'hr.records.manage', 'internalAffairs.read', 'internalAffairs.manage',
          'qa.read', 'qa.manage', 'qa.audit', 'reports.review', 'claims.review',
          'appeals.review', 'verification.review', 'organizations.review', 'cases.read',
          'cases.manage', 'evidence.read', 'evidence.manage', 'accreditation.manage',
          'escalations.manage', 'incidents.manage', 'audit.read', 'system.manage'
        ]);
    }

    function validStaffDirectoryDocument(uid, value) {
      return value is map
        && value.keys().hasOnly([
          'uid', 'employeeId', 'displayName', 'discordUsername', 'title',
          'departmentId', 'rank', 'status', 'joinedAt', 'createdAt', 'updatedAt'
        ])
        && value.uid == uid
        && validStaffEmployeeId(value.employeeId)
        && shortString(value.displayName, 64)
        && value.displayName.size() > 0
        && shortString(value.discordUsername, 64)
        && shortString(value.title, 100)
        && value.title.size() > 0
        && validStaffDepartment(value.departmentId)
        && validStaffRank(value.rank)
        && validStaffStatus(value.status)
        && value.joinedAt is timestamp
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    function validStaffAccessDocument(uid, value) {
      return value is map
        && value.keys().hasOnly([
          'uid', 'employeeId', 'departmentId', 'rank', 'accessLevel', 'status',
          'permissions', 'grantedByUid', 'createdAt', 'updatedAt'
        ])
        && value.uid == uid
        && validStaffEmployeeId(value.employeeId)
        && validStaffDepartment(value.departmentId)
        && validStaffRank(value.rank)
        && value.accessLevel == staffRankLevel(value.rank)
        && validStaffStatus(value.status)
        && validStaffPermissions(value.permissions)
        && 'portal.access' in value.permissions
        && value.grantedByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    function validStaffEmploymentDocument(uid, value) {
      return value is map
        && value.keys().hasOnly([
          'uid', 'employeeId', 'employmentStatus', 'managerUid', 'hireDate',
          'positionHistory', 'notes', 'createdAt', 'updatedAt'
        ])
        && value.uid == uid
        && validStaffEmployeeId(value.employeeId)
        && validStaffStatus(value.employmentStatus)
        && (value.managerUid == null || value.managerUid is string)
        && value.hireDate is timestamp
        && value.positionHistory is list
        && value.positionHistory.size() >= 1
        && value.positionHistory.size() <= 100
        && shortString(value.notes, 5000)
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    function canProvisionStaffG1() {
      return isOwner() || staffPermission('staff.provision');
    }

    function canManageStaffDirectoryG1() {
      return isOwner() || staffPermission('staff.manage');
    }

    function canReadPrivateStaffG1() {
      return isOwner()
        || staffPermission('staff.private.read')
        || staffPermission('hr.records.read');
    }

    function safeDelegatedStaffProvisionG1(value) {
      return staffPermission('staff.provision')
        && value.rank != 'owner'
        && value.accessLevel < currentStaff().accessLevel
        && value.departmentId == currentStaff().departmentId
        && value.permissions.hasOnly(currentStaff().permissions)
        && !value.permissions.hasAny(['permissions.manage', 'system.manage']);
    }

    match /staffDirectory/{uid} {
      allow read: if activeStaff();

      allow create: if canProvisionStaffG1()
        && exists(userPath(uid))
        && get(userPath(uid)).data.status == 'active'
        && validStaffDirectoryDocument(uid, request.resource.data)
        && request.resource.data.displayName == get(userPath(uid)).data.displayName
        && request.resource.data.discordUsername == get(userPath(uid)).data.discordUsername
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(staffAccessPath(uid))
        && getAfter(staffAccessPath(uid)).data.employeeId == request.resource.data.employeeId
        && getAfter(staffAccessPath(uid)).data.departmentId == request.resource.data.departmentId
        && getAfter(staffAccessPath(uid)).data.rank == request.resource.data.rank
        && getAfter(staffAccessPath(uid)).data.status == request.resource.data.status
        && existsAfter(staffEmploymentPath(uid))
        && getAfter(staffEmploymentPath(uid)).data.employeeId == request.resource.data.employeeId;

      allow update: if canManageStaffDirectoryG1()
        && validStaffDirectoryDocument(uid, request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && getAfter(staffAccessPath(uid)).data.departmentId == request.resource.data.departmentId
        && getAfter(staffAccessPath(uid)).data.rank == request.resource.data.rank
        && getAfter(staffAccessPath(uid)).data.status == request.resource.data.status;

      allow delete: if false;
    }

    match /staffAccess/{uid} {
      allow read: if (
          isOwner()
          || (
            activeStaff()
            && (
              uid == request.auth.uid
              || staffPermission('permissions.manage')
              || staffPermission('staff.private.read')
              || staffPermission('hr.records.read')
            )
          )
        );

      allow create: if canProvisionStaffG1()
        && exists(userPath(uid))
        && get(userPath(uid)).data.status == 'active'
        && validStaffAccessDocument(uid, request.resource.data)
        && request.resource.data.grantedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(staffDirectoryPath(uid))
        && getAfter(staffDirectoryPath(uid)).data.employeeId == request.resource.data.employeeId
        && getAfter(staffDirectoryPath(uid)).data.departmentId == request.resource.data.departmentId
        && getAfter(staffDirectoryPath(uid)).data.rank == request.resource.data.rank
        && getAfter(staffDirectoryPath(uid)).data.status == request.resource.data.status
        && (
          (
            isOwner()
            && (
              request.resource.data.rank != 'owner'
              || (
                get(userPath(uid)).data.role == 'owner'
                && request.resource.data.departmentId == 'executive-office'
                && request.resource.data.accessLevel == 100
                && 'permissions.manage' in request.resource.data.permissions
                && 'system.manage' in request.resource.data.permissions
              )
            )
          )
          || safeDelegatedStaffProvisionG1(request.resource.data)
        );

      allow update: if isOwner()
        && validStaffAccessDocument(uid, request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          uid != request.auth.uid
          || (
            request.resource.data.rank == 'owner'
            && request.resource.data.status == 'active'
            && 'portal.access' in request.resource.data.permissions
            && 'permissions.manage' in request.resource.data.permissions
            && 'system.manage' in request.resource.data.permissions
          )
        );

      allow delete: if false;
    }

    match /staffEmployment/{uid} {
      allow read: if activeStaff()
        && (uid == request.auth.uid || canReadPrivateStaffG1());

      allow create: if canProvisionStaffG1()
        && validStaffEmploymentDocument(uid, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(staffDirectoryPath(uid))
        && existsAfter(staffAccessPath(uid))
        && request.resource.data.employeeId == getAfter(staffDirectoryPath(uid)).data.employeeId
        && request.resource.data.employeeId == getAfter(staffAccessPath(uid)).data.employeeId
        && request.resource.data.employmentStatus == getAfter(staffAccessPath(uid)).data.status;

      allow update: if (isOwner() || staffPermission('hr.records.manage'))
        && validStaffEmploymentDocument(uid, request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /staffInbox/{notificationId} {
      allow read: if activeStaff()
        && resource.data.recipientUid == request.auth.uid;

      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'recipientUid', 'senderUid', 'kind', 'title', 'message',
          'href', 'readAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == notificationId
        && request.resource.data.senderUid == request.auth.uid
        && exists(staffAccessPath(request.resource.data.recipientUid))
        && shortString(request.resource.data.kind, 50)
        && shortString(request.resource.data.title, 120)
        && request.resource.data.title.size() > 0
        && shortString(request.resource.data.message, 1000)
        && (request.resource.data.href == null || shortString(request.resource.data.href, 300))
        && request.resource.data.readAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeStaff()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['readAt', 'updatedAt'])
        && request.resource.data.readAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // COMMAND_GENERATION_2_BEGIN

    function commandG2CanManageDepartment(departmentId) {
      return isOwner()
        || (activeStaff()
          && currentStaff().departmentId == departmentId
          && staffPermission('department.manage'))
        || (departmentId == 'human-resources' && staffPermission('hr.records.manage'))
        || (departmentId == 'finance' && staffPermission('finance.manage'))
        || (departmentId == 'customer-service' && staffPermission('tickets.manage'));
    }

    function commandG2CanPublishCompany() {
      return isOwner() || staffPermission('system.manage');
    }

    function commandG2CanManageHr() {
      return isOwner() || staffPermission('hr.records.manage');
    }

    function commandG2CanReadHr() {
      return isOwner() || staffPermission('hr.records.read') || staffPermission('hr.records.manage');
    }

    function commandG2CanReadFinance() {
      return isOwner() || staffPermission('finance.read') || staffPermission('finance.manage');
    }

    function commandG2CanManageFinance() {
      return isOwner() || staffPermission('finance.manage');
    }

    function commandG2CanReadPayroll() {
      return isOwner() || staffPermission('payroll.read') || staffPermission('payroll.manage');
    }

    function commandG2CanManagePayroll() {
      return isOwner() || staffPermission('payroll.manage');
    }

    function commandG2CanManageTicket(departmentId) {
      return isOwner()
        || (staffPermission('tickets.manage') && currentStaff().departmentId == departmentId);
    }

    function commandG2VisibilityRead(value) {
      return activeStaff()
        && (
          value.visibility == 'company'
          || value.departmentId == currentStaff().departmentId
        );
    }

    function commandG2ValidVisibility(value) {
      return value in ['company', 'department'];
    }

    function commandG2ValidPriority(value) {
      return value in ['low', 'normal', 'high', 'critical'];
    }

    // ---------------------------------------------------------------------------
    // TASKS
    // ---------------------------------------------------------------------------
    match /commandTasks/{taskId} {
      allow read: if activeStaff()
        && (
          isOwner()
          || resource.data.assignedToUid == request.auth.uid
          || resource.data.createdByUid == request.auth.uid
          || (staffPermission('department.manage')
            && resource.data.departmentId == currentStaff().departmentId)
        );

      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'description', 'priority', 'status', 'assignedToUid',
          'ownerUid', 'createdByUid', 'departmentId', 'dueAt', 'completedAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == taskId
        && shortString(request.resource.data.title, 120)
        && request.resource.data.title.size() > 0
        && shortString(request.resource.data.description, 1800)
        && commandG2ValidPriority(request.resource.data.priority)
        && request.resource.data.status == 'open'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.ownerUid == request.resource.data.assignedToUid
        && request.resource.data.assignedToUid is string
        && validStaffDepartment(request.resource.data.departmentId)
        && exists(staffAccessPath(request.resource.data.assignedToUid))
        && get(staffAccessPath(request.resource.data.assignedToUid)).data.departmentId == request.resource.data.departmentId
        && (
          request.resource.data.assignedToUid == request.auth.uid
          || (
            staffPermission('department.manage')
            && request.resource.data.departmentId == currentStaff().departmentId
          )
        )
        && (request.resource.data.dueAt == null || request.resource.data.dueAt is timestamp)
        && request.resource.data.completedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeStaff()
        && (
          isOwner()
          || resource.data.assignedToUid == request.auth.uid
          || resource.data.createdByUid == request.auth.uid
          || (staffPermission('department.manage')
            && resource.data.departmentId == currentStaff().departmentId)
        )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'completedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['open', 'in_progress', 'blocked', 'done', 'cancelled']
        && (
          (request.resource.data.status == 'done' && request.resource.data.completedAt == request.time)
          || (request.resource.data.status != 'done' && request.resource.data.completedAt == null)
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // REQUESTS
    // ---------------------------------------------------------------------------
    match /commandRequests/{requestId} {
      allow read: if activeStaff()
        && (
          isOwner()
          || resource.data.requestorUid == request.auth.uid
          || commandG2CanManageDepartment(resource.data.departmentId)
        );

      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'requestorUid', 'departmentId', 'type', 'title', 'details',
          'status', 'reviewedByUid', 'reviewedAt', 'resolutionNote',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == requestId
        && request.resource.data.requestorUid == request.auth.uid
        && validStaffDepartment(request.resource.data.departmentId)
        && request.resource.data.type in ['general', 'access', 'purchase', 'hr', 'scheduling', 'finance']
        && shortString(request.resource.data.title, 120)
        && request.resource.data.title.size() > 0
        && shortString(request.resource.data.details, 2500)
        && request.resource.data.details.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.resolutionNote == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeStaff()
        && commandG2CanManageDepartment(resource.data.departmentId)
        && resource.data.requestorUid != request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewedByUid', 'reviewedAt', 'resolutionNote', 'updatedAt'
        ])
        && request.resource.data.status in ['pending', 'approved', 'declined', 'closed']
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && shortString(request.resource.data.resolutionNote, 1500)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // ANNOUNCEMENTS
    // ---------------------------------------------------------------------------
    match /commandAnnouncements/{announcementId} {
      allow read: if activeStaff()
        && (
          resource.data.audience == 'company'
          || resource.data.departmentId == currentStaff().departmentId
        );

      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'body', 'audience', 'departmentId', 'priority', 'pinned',
          'publishedAt', 'expiresAt', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == announcementId
        && shortString(request.resource.data.title, 140)
        && request.resource.data.title.size() > 0
        && shortString(request.resource.data.body, 5000)
        && request.resource.data.body.size() > 0
        && request.resource.data.audience in ['company', 'department']
        && commandG2ValidPriority(request.resource.data.priority)
        && request.resource.data.pinned is bool
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.publishedAt == request.time
        && (request.resource.data.expiresAt == null || request.resource.data.expiresAt is timestamp)
        && (
          (
            request.resource.data.audience == 'company'
            && request.resource.data.departmentId == null
            && commandG2CanPublishCompany()
          )
          || (
            request.resource.data.audience == 'department'
            && request.resource.data.departmentId == currentStaff().departmentId
            && (staffPermission('department.manage') || commandG2CanPublishCompany())
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // DOCUMENT LIBRARY
    // ---------------------------------------------------------------------------
    match /commandDocuments/{documentId} {
      allow read: if commandG2VisibilityRead(resource.data);

      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'description', 'url', 'category', 'visibility',
          'departmentId', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == documentId
        && shortString(request.resource.data.title, 140)
        && request.resource.data.title.size() > 0
        && shortString(request.resource.data.description, 1200)
        && shortString(request.resource.data.url, 1000)
        && request.resource.data.url.matches('^https://.+')
        && request.resource.data.category in ['policy', 'procedure', 'form', 'guide', 'training', 'reference']
        && commandG2ValidVisibility(request.resource.data.visibility)
        && request.resource.data.createdByUid == request.auth.uid
        && (
          (
            request.resource.data.visibility == 'company'
            && request.resource.data.departmentId == null
            && commandG2CanPublishCompany()
          )
          || (
            request.resource.data.visibility == 'department'
            && request.resource.data.departmentId == currentStaff().departmentId
            && (staffPermission('department.manage') || commandG2CanPublishCompany())
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // PROJECTS
    // ---------------------------------------------------------------------------
    match /commandProjects/{projectId} {
      allow read: if commandG2VisibilityRead(resource.data);

      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'description', 'status', 'visibility', 'departmentId',
          'leadUid', 'memberUids', 'dueAt', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == projectId
        && shortString(request.resource.data.title, 140)
        && request.resource.data.title.size() > 0
        && shortString(request.resource.data.description, 2500)
        && request.resource.data.status == 'planning'
        && commandG2ValidVisibility(request.resource.data.visibility)
        && validStaffDepartment(request.resource.data.departmentId)
        && request.resource.data.leadUid is string
        && exists(staffAccessPath(request.resource.data.leadUid))
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 1
        && request.resource.data.memberUids.size() <= 50
        && request.resource.data.leadUid in request.resource.data.memberUids
        && (request.resource.data.dueAt == null || request.resource.data.dueAt is timestamp)
        && request.resource.data.createdByUid == request.auth.uid
        && (
          commandG2CanPublishCompany()
          || (
            staffPermission('department.manage')
            && request.resource.data.departmentId == currentStaff().departmentId
            && request.resource.data.visibility == 'department'
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeStaff()
        && (
          isOwner()
          || resource.data.leadUid == request.auth.uid
          || (staffPermission('department.manage')
            && resource.data.departmentId == currentStaff().departmentId)
        )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['planning', 'active', 'on_hold', 'complete', 'cancelled']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // MEETINGS
    // ---------------------------------------------------------------------------
    match /commandMeetings/{meetingId} {
      allow read: if commandG2VisibilityRead(resource.data);

      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'summary', 'startsAt', 'endsAt', 'location', 'url',
          'visibility', 'departmentId', 'organizerUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == meetingId
        && shortString(request.resource.data.title, 140)
        && request.resource.data.title.size() > 0
        && shortString(request.resource.data.summary, 2000)
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt > request.resource.data.startsAt
        && shortString(request.resource.data.location, 160)
        && (request.resource.data.url == null
          || (shortString(request.resource.data.url, 1000)
            && request.resource.data.url.matches('^https://.+')))
        && commandG2ValidVisibility(request.resource.data.visibility)
        && request.resource.data.organizerUid == request.auth.uid
        && (
          (
            request.resource.data.visibility == 'company'
            && request.resource.data.departmentId == null
            && commandG2CanPublishCompany()
          )
          || (
            request.resource.data.visibility == 'department'
            && request.resource.data.departmentId == currentStaff().departmentId
            && (staffPermission('department.manage') || commandG2CanPublishCompany())
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // LEAVE
    // ---------------------------------------------------------------------------
    match /commandLeave/{leaveId} {
      allow read: if activeStaff()
        && (
          resource.data.requestorUid == request.auth.uid
          || commandG2CanReadHr()
        );

      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'requestorUid', 'employeeId', 'type', 'startsAt', 'endsAt',
          'reason', 'status', 'reviewerUid', 'reviewedAt', 'reviewNote',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == leaveId
        && request.resource.data.requestorUid == request.auth.uid
        && request.resource.data.employeeId == currentStaff().employeeId
        && request.resource.data.type in ['personal', 'vacation', 'medical', 'school', 'other']
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt >= request.resource.data.startsAt
        && shortString(request.resource.data.reason, 1500)
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewerUid == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewNote == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if commandG2CanManageHr()
        && resource.data.requestorUid != request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'reviewerUid', 'reviewedAt', 'reviewNote', 'updatedAt'
        ])
        && request.resource.data.status in ['approved', 'declined', 'cancelled']
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && shortString(request.resource.data.reviewNote, 1500)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // HR EMPLOYEE LIFECYCLE
    // ---------------------------------------------------------------------------
    match /commandLifecycle/{recordId} {
      allow read: if commandG2CanReadHr();

      allow create: if commandG2CanManageHr()
        && request.resource.data.keys().hasOnly([
          'id', 'employeeUid', 'action', 'title', 'notes', 'checklist',
          'completedSteps', 'status', 'openedByUid', 'completedAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == recordId
        && request.resource.data.employeeUid is string
        && exists(staffAccessPath(request.resource.data.employeeUid))
        && request.resource.data.action in ['onboarding', 'transfer', 'promotion', 'status_change', 'offboarding']
        && shortString(request.resource.data.title, 140)
        && request.resource.data.title.size() > 0
        && shortString(request.resource.data.notes, 3000)
        && request.resource.data.checklist is list
        && request.resource.data.checklist.size() <= 30
        && request.resource.data.completedSteps is list
        && request.resource.data.completedSteps.size() == 0
        && request.resource.data.status == 'open'
        && request.resource.data.openedByUid == request.auth.uid
        && request.resource.data.completedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if commandG2CanManageHr()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'completedAt', 'completedSteps', 'updatedAt'
        ])
        && request.resource.data.status in ['open', 'in_progress', 'complete', 'cancelled']
        && request.resource.data.completedSteps is list
        && request.resource.data.completedSteps.size() <= resource.data.checklist.size()
        && (
          (request.resource.data.status == 'complete' && request.resource.data.completedAt == request.time)
          || (request.resource.data.status != 'complete' && request.resource.data.completedAt == null)
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // FINANCE
    // ---------------------------------------------------------------------------
    match /commandFinance/{entryId} {
      allow read: if commandG2CanReadFinance();

      allow create: if commandG2CanManageFinance()
        && request.resource.data.keys().hasOnly([
          'id', 'entryType', 'amountCents', 'category', 'memo', 'departmentId',
          'status', 'submittedByUid', 'approvedByUid', 'approvedAt', 'occurredAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == entryId
        && request.resource.data.entryType in ['expense', 'income', 'reimbursement', 'purchase']
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && shortString(request.resource.data.category, 80)
        && request.resource.data.category.size() > 0
        && shortString(request.resource.data.memo, 180)
        && request.resource.data.memo.size() > 0
        && validStaffDepartment(request.resource.data.departmentId)
        && request.resource.data.status in ['pending', 'approved']
        && request.resource.data.submittedByUid == request.auth.uid
        && (
          (
            request.resource.data.status == 'approved'
            && request.resource.data.approvedByUid == request.auth.uid
            && request.resource.data.approvedAt == request.time
          )
          || (
            request.resource.data.status == 'pending'
            && request.resource.data.approvedByUid == null
            && request.resource.data.approvedAt == null
          )
        )
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if commandG2CanManageFinance()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'approvedByUid', 'approvedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['approved', 'declined', 'posted']
        && request.resource.data.approvedByUid == request.auth.uid
        && request.resource.data.approvedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // PAYROLL
    // ---------------------------------------------------------------------------
    match /commandPayroll/{statementId} {
      allow read: if activeStaff()
        && (
          resource.data.employeeUid == request.auth.uid
          || commandG2CanReadPayroll()
        );

      allow create: if commandG2CanManagePayroll()
        && request.resource.data.keys().hasOnly([
          'id', 'employeeUid', 'periodLabel', 'periodStart', 'periodEnd',
          'grossCents', 'adjustmentsCents', 'netCents', 'status', 'notes',
          'createdByUid', 'approvedByUid', 'paidAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == statementId
        && request.resource.data.employeeUid is string
        && exists(staffAccessPath(request.resource.data.employeeUid))
        && shortString(request.resource.data.periodLabel, 80)
        && request.resource.data.periodLabel.size() > 0
        && request.resource.data.periodStart is timestamp
        && request.resource.data.periodEnd is timestamp
        && request.resource.data.periodEnd >= request.resource.data.periodStart
        && request.resource.data.grossCents is int
        && request.resource.data.adjustmentsCents is int
        && request.resource.data.netCents is int
        && request.resource.data.grossCents >= 0
        && request.resource.data.netCents >= 0
        && request.resource.data.status == 'draft'
        && shortString(request.resource.data.notes, 1500)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.approvedByUid == null
        && request.resource.data.paidAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if commandG2CanManagePayroll()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'approvedByUid', 'paidAt', 'updatedAt'
        ])
        && request.resource.data.status in ['approved', 'paid', 'void']
        && request.resource.data.approvedByUid == request.auth.uid
        && (
          (request.resource.data.status == 'paid' && request.resource.data.paidAt == request.time)
          || (request.resource.data.status != 'paid' && request.resource.data.paidAt == null)
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // INTERNAL SERVICE DESK
    // ---------------------------------------------------------------------------
    match /commandTickets/{ticketId} {
      allow read: if activeStaff()
        && (
          resource.data.requesterUid == request.auth.uid
          || isOwner()
          || staffPermission('tickets.all.read')
          || (staffPermission('tickets.manage')
            && resource.data.departmentId == currentStaff().departmentId)
        );

      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'requesterUid', 'departmentId', 'category', 'priority', 'subject',
          'details', 'status', 'assignedToUid', 'resolvedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == ticketId
        && request.resource.data.requesterUid == request.auth.uid
        && validStaffDepartment(request.resource.data.departmentId)
        && request.resource.data.category in ['general', 'access', 'technical', 'hr', 'finance', 'policy']
        && commandG2ValidPriority(request.resource.data.priority)
        && shortString(request.resource.data.subject, 140)
        && request.resource.data.subject.size() > 0
        && shortString(request.resource.data.details, 3000)
        && request.resource.data.details.size() > 0
        && request.resource.data.status == 'open'
        && request.resource.data.assignedToUid == null
        && request.resource.data.resolvedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if commandG2CanManageTicket(resource.data.departmentId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'assignedToUid', 'resolvedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['open', 'in_progress', 'resolved', 'closed']
        && request.resource.data.assignedToUid == request.auth.uid
        && (
          (request.resource.data.status == 'resolved' && request.resource.data.resolvedAt == request.time)
          || (request.resource.data.status != 'resolved' && request.resource.data.resolvedAt == null)
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // COMMAND_GENERATION_2_END

    // COMMAND_GENERATION_3_BEGIN

    function commandG3CasesRead() {
      return isOwner() || staffPermission('cases.read') || staffPermission('cases.manage');
    }

    function commandG3CasesManage() {
      return isOwner() || staffPermission('cases.manage');
    }

    function commandG3EvidenceRead() {
      return isOwner() || staffPermission('evidence.read') || staffPermission('evidence.manage');
    }

    function commandG3EvidenceManage() {
      return isOwner() || staffPermission('evidence.manage');
    }

    function commandG3QaRead() {
      return isOwner() || staffPermission('qa.read') || staffPermission('qa.manage') || staffPermission('qa.audit');
    }

    function commandG3QaManage() {
      return isOwner() || staffPermission('qa.manage') || staffPermission('qa.audit');
    }

    function commandG3PrRead() {
      return isOwner() || staffPermission('pr.manage') || staffPermission('pr.approve');
    }

    function commandG3ValidPriority(value) {
      return value in ['low', 'normal', 'high', 'critical'];
    }

    function commandG3NullableString(value, maxLength) {
      return value == null || shortString(value, maxLength);
    }

    function commandG3ValidCase(value, caseId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'title', 'type', 'status', 'priority', 'departmentId',
          'subjectType', 'subjectId', 'assignedToUid', 'summary', 'createdByUid',
          'createdAt', 'updatedAt'
        ])
        && value.id == caseId
        && validCognitusId(value.cognitusId, 'CAS')
        && shortString(value.title, 140)
        && value.title.size() > 0
        && value.type in ['investigation', 'data_quality', 'abuse', 'organization', 'support_escalation', 'other']
        && value.status in ['open', 'active', 'on_hold', 'closed', 'archived']
        && commandG3ValidPriority(value.priority)
        && validStaffDepartment(value.departmentId)
        && value.subjectType in ['none', 'profile', 'organization', 'report', 'ticket']
        && commandG3NullableString(value.subjectId, 140)
        && (value.assignedToUid == null || value.assignedToUid is string)
        && shortString(value.summary, 3000)
        && value.summary.size() > 0
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandCases/{caseId} {
      allow read: if commandG3CasesRead();

      allow create: if commandG3CasesManage()
        && commandG3ValidCase(request.resource.data, caseId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if commandG3CasesManage()
        && commandG3ValidCase(request.resource.data, caseId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function commandG3ValidEvidence(value, evidenceId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'caseId', 'type', 'label', 'sourceUrl', 'notes',
          'status', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && value.id == evidenceId
        && validCognitusId(value.cognitusId, 'EVD')
        && shortString(value.caseId, 140)
        && value.caseId.size() > 0
        && value.type in ['link', 'statement', 'record', 'other']
        && shortString(value.label, 140)
        && value.label.size() > 0
        && commandG3NullableString(value.sourceUrl, 1000)
        && shortString(value.notes, 2500)
        && value.status in ['unverified', 'corroborated', 'disputed', 'invalid', 'superseded']
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandEvidence/{evidenceId} {
      allow read: if commandG3EvidenceRead();

      allow create: if commandG3EvidenceManage()
        && commandG3ValidEvidence(request.resource.data, evidenceId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if commandG3EvidenceManage()
        && commandG3ValidEvidence(request.resource.data, evidenceId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function commandG3ValidAccreditation(value, recordId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'organizationId', 'organizationName', 'level', 'status',
          'conditions', 'reviewerUid', 'expiresAt', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && value.id == recordId
        && validCognitusId(value.cognitusId, 'ACR')
        && shortString(value.organizationId, 140)
        && value.organizationId.size() > 0
        && shortString(value.organizationName, 120)
        && value.organizationName.size() > 0
        && value.level in ['standard', 'enhanced', 'conditional']
        && value.status in [
          'preliminary_review', 'documentation_review', 'risk_assessment', 'final_review',
          'accredited', 'denied', 'conditional', 'suspended', 'expired'
        ]
        && shortString(value.conditions, 2500)
        && value.reviewerUid is string
        && (value.expiresAt == null || value.expiresAt is timestamp)
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandAccreditations/{recordId} {
      allow read: if isOwner() || staffPermission('accreditation.manage');

      allow create: if (isOwner() || staffPermission('accreditation.manage'))
        && commandG3ValidAccreditation(request.resource.data, recordId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isOwner() || staffPermission('accreditation.manage'))
        && commandG3ValidAccreditation(request.resource.data, recordId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function commandG3ValidEscalation(value, escalationId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'title', 'reason', 'fromDepartmentId', 'toDepartmentId',
          'sourceType', 'sourceId', 'severity', 'status', 'assignedToUid', 'createdByUid',
          'createdAt', 'updatedAt'
        ])
        && value.id == escalationId
        && validCognitusId(value.cognitusId, 'ESC')
        && shortString(value.title, 140)
        && value.title.size() > 0
        && shortString(value.reason, 2500)
        && value.reason.size() > 0
        && validStaffDepartment(value.fromDepartmentId)
        && validStaffDepartment(value.toDepartmentId)
        && value.sourceType in ['case', 'ticket', 'report', 'incident', 'other']
        && commandG3NullableString(value.sourceId, 140)
        && commandG3ValidPriority(value.severity)
        && value.status in ['open', 'assigned', 'in_progress', 'resolved', 'closed']
        && (value.assignedToUid == null || value.assignedToUid is string)
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandEscalations/{escalationId} {
      allow read: if isOwner() || staffPermission('escalations.manage');

      allow create: if (isOwner() || staffPermission('escalations.manage'))
        && commandG3ValidEscalation(request.resource.data, escalationId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isOwner() || staffPermission('escalations.manage'))
        && commandG3ValidEscalation(request.resource.data, escalationId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function commandG3ValidIncident(value, incidentId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'title', 'category', 'severity', 'status', 'summary',
          'commanderUid', 'departmentId', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && value.id == incidentId
        && validCognitusId(value.cognitusId, 'INC')
        && shortString(value.title, 140)
        && value.title.size() > 0
        && value.category in ['security', 'data_integrity', 'coordinated_abuse', 'organization_dispute', 'system', 'other']
        && value.severity in ['normal', 'high', 'critical']
        && value.status in ['active', 'contained', 'monitoring', 'resolved', 'closed']
        && shortString(value.summary, 3000)
        && value.summary.size() > 0
        && value.commanderUid is string
        && validStaffDepartment(value.departmentId)
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandIncidents/{incidentId} {
      allow read: if isOwner() || staffPermission('incidents.manage');

      allow create: if (isOwner() || staffPermission('incidents.manage'))
        && commandG3ValidIncident(request.resource.data, incidentId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isOwner() || staffPermission('incidents.manage'))
        && commandG3ValidIncident(request.resource.data, incidentId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function commandG3ValidQaReview(value, reviewId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'subjectType', 'subjectId', 'departmentId', 'employeeUid',
          'score', 'status', 'findings', 'reviewerUid', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && value.id == reviewId
        && validCognitusId(value.cognitusId, 'QAR')
        && value.subjectType in ['ticket', 'report_review', 'appeal_review', 'case', 'department_process', 'other']
        && shortString(value.subjectId, 140)
        && value.subjectId.size() > 0
        && validStaffDepartment(value.departmentId)
        && (value.employeeUid == null || value.employeeUid is string)
        && value.score is int
        && value.score >= 0
        && value.score <= 100
        && value.status in ['closed', 'finding_open', 'appealed', 'superseded']
        && shortString(value.findings, 3000)
        && value.reviewerUid is string
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandQaReviews/{reviewId} {
      allow read: if commandG3QaRead();

      allow create: if commandG3QaManage()
        && commandG3ValidQaReview(request.resource.data, reviewId)
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if commandG3QaManage()
        && commandG3ValidQaReview(request.resource.data, reviewId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function commandG3ValidCorrectiveAction(value, actionId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'qaReviewId', 'departmentId', 'title', 'ownerUid',
          'status', 'plan', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && value.id == actionId
        && validCognitusId(value.cognitusId, 'CAR')
        && shortString(value.qaReviewId, 140)
        && value.qaReviewId.size() > 0
        && validStaffDepartment(value.departmentId)
        && shortString(value.title, 180)
        && value.title.size() > 0
        && (value.ownerUid == null || value.ownerUid is string)
        && value.status in ['open', 'in_progress', 'completed', 'closed']
        && shortString(value.plan, 3000)
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandCorrectiveActions/{actionId} {
      allow read: if commandG3QaRead()
        || (activeStaff()
          && currentStaff().departmentId == resource.data.departmentId
          && staffPermission('department.manage'));

      allow create: if commandG3QaManage()
        && commandG3ValidCorrectiveAction(request.resource.data, actionId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (
          commandG3QaManage()
          || (activeStaff()
            && currentStaff().departmentId == resource.data.departmentId
            && staffPermission('department.manage'))
        )
        && commandG3ValidCorrectiveAction(request.resource.data, actionId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.qaReviewId == resource.data.qaReviewId
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function commandG3ValidPrCampaign(value, campaignId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'title', 'objective', 'audience', 'ownerUid', 'status',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && value.id == campaignId
        && validCognitusId(value.cognitusId, 'CAM')
        && shortString(value.title, 140)
        && value.title.size() > 0
        && shortString(value.objective, 2500)
        && value.objective.size() > 0
        && shortString(value.audience, 140)
        && value.audience.size() > 0
        && value.ownerUid is string
        && value.status in ['planned', 'active', 'paused', 'completed', 'cancelled']
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandPrCampaigns/{campaignId} {
      allow read: if commandG3PrRead();

      allow create: if (isOwner() || staffPermission('pr.manage'))
        && commandG3ValidPrCampaign(request.resource.data, campaignId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isOwner() || staffPermission('pr.manage'))
        && commandG3ValidPrCampaign(request.resource.data, campaignId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function commandG3ValidPrItem(value, itemId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'type', 'title', 'status', 'body', 'url', 'ownerUid',
          'approvedByUid', 'approvedAt', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && value.id == itemId
        && validCognitusId(value.cognitusId, 'PRI')
        && value.type in ['publication', 'partnership', 'media_inquiry', 'brand_resource', 'crisis_communication']
        && shortString(value.title, 140)
        && value.title.size() > 0
        && value.status in ['draft', 'pending_approval', 'approved', 'published', 'closed', 'rejected']
        && shortString(value.body, 4000)
        && commandG3NullableString(value.url, 1000)
        && value.ownerUid is string
        && (value.approvedByUid == null || value.approvedByUid is string)
        && (value.approvedAt == null || value.approvedAt is timestamp)
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandPrItems/{itemId} {
      allow read: if commandG3PrRead();

      allow create: if (isOwner() || staffPermission('pr.manage'))
        && commandG3ValidPrItem(request.resource.data, itemId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status in ['draft', 'pending_approval']
        && request.resource.data.approvedByUid == null
        && request.resource.data.approvedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isOwner() || staffPermission('pr.manage'))
        && commandG3ValidPrItem(request.resource.data, itemId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['draft', 'pending_approval', 'published', 'closed']
        && request.resource.data.approvedByUid == resource.data.approvedByUid
        && request.resource.data.approvedAt == resource.data.approvedAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'type', 'title', 'status', 'body', 'url', 'ownerUid', 'updatedAt'
        ]);

      allow update: if (isOwner() || staffPermission('pr.approve'))
        && commandG3ValidPrItem(request.resource.data, itemId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'approvedByUid', 'approvedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.approvedByUid == request.auth.uid
        && request.resource.data.approvedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function commandG3ValidCsMacro(value, macroId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'title', 'category', 'body', 'status', 'createdByUid',
          'createdAt', 'updatedAt'
        ])
        && value.id == macroId
        && validCognitusId(value.cognitusId, 'CSR')
        && shortString(value.title, 140)
        && value.title.size() > 0
        && value.category in ['account', 'background_check_help', 'reports', 'appeals', 'organizations', 'promotional_access', 'technical', 'general']
        && shortString(value.body, 4000)
        && value.body.size() > 0
        && value.status in ['active', 'archived']
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandCsMacros/{macroId} {
      allow read: if isOwner() || staffPermission('cs.manage') || staffPermission('tickets.manage');

      allow create: if (isOwner() || staffPermission('cs.manage'))
        && commandG3ValidCsMacro(request.resource.data, macroId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isOwner() || staffPermission('cs.manage'))
        && commandG3ValidCsMacro(request.resource.data, macroId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function commandG3ValidExecutiveApproval(value, approvalId) {
      return value is map
        && value.keys().hasOnly([
          'id', 'cognitusId', 'type', 'departmentId', 'title', 'reason', 'status',
          'requestedByUid', 'decidedByUid', 'decidedAt', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && value.id == approvalId
        && validCognitusId(value.cognitusId, 'APR')
        && value.type in ['policy_exception', 'access_change', 'staffing', 'financial', 'operational', 'other']
        && validStaffDepartment(value.departmentId)
        && shortString(value.title, 140)
        && value.title.size() > 0
        && shortString(value.reason, 2500)
        && value.reason.size() > 0
        && value.status in ['pending', 'approved', 'denied', 'cancelled']
        && value.requestedByUid is string
        && (value.decidedByUid == null || value.decidedByUid is string)
        && (value.decidedAt == null || value.decidedAt is timestamp)
        && value.createdByUid is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    match /commandExecutiveApprovals/{approvalId} {
      allow read: if isOwner()
        || staffPermission('system.manage')
        || (activeStaff() && resource.data.requestedByUid == request.auth.uid);

      allow create: if (isOwner() || staffPermission('system.manage'))
        && commandG3ValidExecutiveApproval(request.resource.data, approvalId)
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.decidedByUid == null
        && request.resource.data.decidedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isOwner() || staffPermission('system.manage'))
        && commandG3ValidExecutiveApproval(request.resource.data, approvalId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.cognitusId == resource.data.cognitusId
        && request.resource.data.requestedByUid == resource.data.requestedByUid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'decidedByUid', 'decidedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['approved', 'denied']
        && request.resource.data.decidedByUid == request.auth.uid
        && request.resource.data.decidedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // COMMAND_GENERATION_3_END

    // ============================================================
    // FINAL DEFAULT-DENY BOUNDARY
    //
    // Any collection introduced by future Cognitus code is denied
    // until a deliberate rule is added. This prevents new features
    // from silently inheriting access.
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
