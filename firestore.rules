    match /checkLogs/{checkId} {
      allow read: if isReviewer()
        || (signedIn() && resource.data.checkedByUid == request.auth.uid)
        || (isEmployerMember() && sameOrg(resource.data.organizationId));

      allow create: if activeAccount()
        && (request.resource.data.organizationId == null || canRunChecks(request.resource.data.organizationId))
        && request.resource.data.keys().hasOnly([
          'id', 'cognitusId', 'checkedByUid', 'checkedByCognitusId', 'organizationId',
          'searchType', 'searchField', 'searchQuery', 'reason', 'additionalNotes',
