        && request.resource.data.organizationCognitusId == get(organizationPath(request.resource.data.organizationId)).data.cognitusId
        && request.resource.data.organizationName == get(organizationPath(request.resource.data.organizationId)).data.name
        && shortString(request.resource.data.positionTitle, 100)
        && request.resource.data.positionTitle.size() > 0
        && shortString(request.resource.data.reason, 1200)
